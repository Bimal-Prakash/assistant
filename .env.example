# ---------------------------------------------------------
# STT (Speech-To-Text) Configuration
# ---------------------------------------------------------
# run.py uses Google Speech Recognition API (cloud, free tier)
# via the `speech_recognition` library. No local STT model needed.


# ---------------------------------------------------------
# General / Backend / Core Configuration
# ---------------------------------------------------------
JARVIS_BACKEND_URL="http://127.0.0.1:8000"
JARVIS_TERMINAL_MINIMAL="1"
JARVIS_ALWAYS_ON_COMMAND_STRICT="1"
JARVIS_SKIP_INTERNAL_STT_IMPORTS="0"
JARVIS_HUD="0"

# Audio & Microphone
JARVIS_MIC_DEVICE_INDEX="auto"
JARVIS_WAKE_ACTIVE_SECONDS="7"
JARVIS_LISTEN_MAX_SECONDS="8"

# Wake Word & Recognition Confidence
JARVIS_ACCENT_TOLERANT="1"
JARVIS_WAKE_FUZZY_THRESHOLD="0.86"
JARVIS_WAKE_MIN_CONFIDENCE="0.45"
JARVIS_COMMAND_MIN_CONFIDENCE="0.32"

# Interaction Modes
JARVIS_PUSH_TO_TALK_SPACE="1"
JARVIS_PUSH_TO_TALK_MAX_SECONDS="8"
JARVIS_PUSH_TO_TALK_POLL_SECONDS="0.015"

# TTS & Output
JARVIS_SPOKEN_FILLER="0"
JARVIS_EDGE_TTS_VOICE="en-IN-NeerjaNeural"

# Cache
JARVIS_START_APPS_CACHE_TTL_SECONDS="120"

# ---------------------------------------------------------
# Ollama / LLM Configuration
# ---------------------------------------------------------
OLLAMA_API_URL="http://127.0.0.1:11434/api/generate"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_VISION_MODEL="llava-phi3"
OLLAMA_TIMEOUT_SECONDS="60"
OLLAMA_KEEP_ALIVE_SECONDS="30"

# ---------------------------------------------------------
# Server / Host Configuration
# ---------------------------------------------------------
JARVIS_HOST="0.0.0.0"
JARVIS_PORT="8000"

# ---------------------------------------------------------
# Memory / Database Configuration
# ---------------------------------------------------------
JARVIS_MEMORY_DATABASE_URL=""
JARVIS_MEMORY_HISTORY_LIMIT="12"
JARVIS_MEMORY_FACT_LIMIT="20"

# ---------------------------------------------------------
# Media Settings
# ---------------------------------------------------------
JARVIS_PREVIOUS_TRACK_PRESS_COUNT="2"
JARVIS_PREVIOUS_TRACK_PRESS_INTERVAL_SECONDS="0.18"

# ---------------------------------------------------------
# Obsidian Integration
# ---------------------------------------------------------
OBSIDIAN_VAULT_PATH="C:/Path/To/Your/Obsidian Vault"
JARVIS_THOUGHTS_PATH="C:/Path/To/Your/Obsidian Vault/JARVIS_THOUGHTS.md" 
JARVIS_STT_CORRECTIONS="oldword:newword"

# ---------------------------------------------------------
# Background Daemon
# ---------------------------------------------------------
ENABLE_PROACTIVE_BACKGROUND_TASKS="1"
